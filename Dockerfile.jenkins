# Jenkins + docker-cli для Docker-in-Docker (через docker.sock)
FROM jenkins/jenkins:lts

USER root

# Устанавливаем docker-cli (только клиент, без демона)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
        > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Добавляем jenkins в группу docker (GID совпадает с хостом)
RUN groupadd -g 986 docker 2>/dev/null || true && \
    usermod -aG docker jenkins

# Git safe.directory: Jenkins работает от root, а часть файлов принадлежит uid 1000.
# Покрываем и workspace, и caches (lightweight checkout хранит репозиторий там)
RUN printf '[safe]\n	directory = *\n' >> /etc/gitconfig

# Запускаем от root — нужно для доступа к docker.sock (Docker Desktop на Linux)
# В продакшене используйте socat-прокси или TCP-сокет
USER root
